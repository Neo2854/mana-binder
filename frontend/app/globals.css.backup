:root {
  /* Light Professional Theme */
  --bg-primary: #f8fafc;
  --bg-secondary: #ffffff;
  --bg-tertiary: #f1f5f9;
  --bg-card: #ffffff;
  --accent-primary: #3b82f6;
  --accent-secondary: #60a5fa;
  --accent-gold: #d97706;
  --text-primary: #0f172a;
  --text-secondary: #64748b;
  --text-tertiary: #94a3b8;
  --border-color: #e2e8f0;
  --border-hover: #cbd5e1;
  --success: #10b981;
  --danger: #ef4444;
  --warning: #f59e0b;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  line-height: 1.6;
}

/* Navigation */
.navigation {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  padding: 0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: var(--shadow-sm);
}

.nav-container {
  max-width: 1600px;
  margin: 0 auto;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--accent-primary);
}

.brand-icon {
  font-size: 1.75rem;
}

.brand-text {
  background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.nav-links {
  display: flex;
  gap: 0.5rem;
}

.nav-link {
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 1rem;
  font-weight: 500;
  padding: 0.625rem 1.25rem;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.nav-link:hover {
  color: var(--text-primary);
  background: var(--bg-tertiary);
}

.nav-link.active {
  color: var(--accent-primary);
  background: var(--bg-tertiary);
}

/* Main Content */
.main-content {
  min-height: calc(100vh - 80px);
  padding: 2rem;
}

/* Page Container */
.page-container {
  max-width: 1600px;
  margin: 0 auto;
}

.page-title {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 2rem;
  color: var(--text-primary);
  letter-spacing: -0.025em;
}

/* Cards & Sections */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: var(--shadow);
}

.card h2, .card h3 {
  color: var(--text-primary);
  margin-bottom: 1rem;
  font-weight: 600;
}

/* Collection Layout with Folders */
.collection-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 2rem;
  align-items: start;
}

/* Folders Sidebar */
.folders-sidebar {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.25rem;
  position: sticky;
  top: 100px;
  max-height: calc(100vh - 140px);
  overflow-y: auto;
  box-shadow: var(--shadow);
}

.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 2px solid var(--border-color);
}

.sidebar-header h2 {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
}

.new-folder-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1rem;
  background: var(--bg-tertiary);
  border-radius: 8px;
  margin-bottom: 1rem;
}

.color-picker {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.color-picker label {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-secondary);
}

.color-options {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.color-option {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  border: 2px solid transparent;
  cursor: pointer;
  transition: all 0.2s;
}

.color-option:hover {
  transform: scale(1.1);
  box-shadow: var(--shadow-md);
}

.color-option.active {
  border-color: var(--text-primary);
  box-shadow: var(--shadow-md);
}

.folder-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.folder-divider {
  height: 1px;
  background: var(--border-color);
  margin: 0.5rem 0;
}

.folder-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s;
  border: 1px solid transparent;
}

.folder-item:hover {
  background: var(--bg-tertiary);
  border-color: var(--border-hover);
}

.folder-item.active {
  background: var(--bg-tertiary);
  border-color: var(--accent-primary);
  box-shadow: var(--shadow-sm);
}

.folder-icon {
  font-size: 1.25rem;
  flex-shrink: 0;
}

.folder-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.folder-name {
  font-weight: 500;
  color: var(--text-primary);
  font-size: 0.9375rem;
}

.folder-count {
  font-size: 0.8125rem;
  color: var(--text-secondary);
}

.folder-delete {
  padding: 0.25rem 0.5rem;
  background: none;
  border: none;
  color: var(--text-tertiary);
  cursor: pointer;
  border-radius: 4px;
  font-size: 0.875rem;
  transition: all 0.2s;
  opacity: 0;
}

.folder-item:hover .folder-delete {
  opacity: 1;
}

.folder-delete:hover {
  background: var(--danger);
  color: white;
}

/* Main Collection Area */
.collection-main {
  min-width: 0;
}

/* Search Section */
.search-section {
  margin-bottom: 2rem;
}

.search-bar {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.search-input, .filter-input {
  flex: 1;
  padding: 0.75rem 1rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 0.9375rem;
  transition: all 0.2s;
}

.search-input:focus, .filter-input:focus {
  outline: none;
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.filter-input {
  min-width: 250px;
}

/* Buttons */
.btn {
  padding: 0.75rem 1.25rem;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  font-size: 0.9375rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  background: var(--bg-secondary);
  color: var(--text-primary);
  white-space: nowrap;
}

.btn:hover {
  background: var(--bg-tertiary);
  border-color: var(--border-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow);
}

.btn:active {
  transform: translateY(0);
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.btn-primary {
  background: var(--accent-primary);
  border-color: var(--accent-primary);
  color: white;
}

.btn-primary:hover {
  background: var(--accent-secondary);
  border-color: var(--accent-secondary);
}

.btn-success {
  background: var(--success);
  border-color: var(--success);
  color: white;
}

.btn-success:hover {
  background: #059669;
  border-color: #059669;
}

.btn-danger {
  background: var(--danger);
  border-color: var(--danger);
  color: white;
}

.btn-danger:hover {
  background: #dc2626;
  border-color: #dc2626;
}

.btn-ghost {
  background: transparent;
  border-color: var(--border-color);
  color: var(--text-secondary);
}

.btn-ghost:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.btn-sm {
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
}

.btn-xs {
  padding: 0.375rem 0.75rem;
  font-size: 0.8125rem;
}

/* Inputs */
.input, .textarea, .select, .select-sm {
  padding: 0.625rem 0.875rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 0.9375rem;
  font-family: inherit;
  transition: all 0.2s;
  width: 100%;
}

.input:focus, .textarea:focus, .select:focus, .select-sm:focus {
  outline: none;
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.input-sm {
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
}

.select-sm {
  padding: 0.375rem 0.625rem;
  font-size: 0.875rem;
}

/* Card Grid */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
  margin-top: 1.5rem;
}

.card-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 1rem;
  transition: all 0.2s;
  box-shadow: var(--shadow-sm);
}

.card-item:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--accent-primary);
}

.card-image {
  width: 100%;
  border-radius: 8px;
  margin-bottom: 0.75rem;
  box-shadow: var(--shadow);
}

.card-info h4 {
  color: var(--text-primary);
  margin-bottom: 0.5rem;
  font-size: 1rem;
  font-weight: 600;
}

.card-type {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin-bottom: 0.25rem;
}

.card-set {
  color: var(--text-tertiary);
  font-size: 0.8125rem;
  margin-bottom: 0.5rem;
}

.mana-cost {
  font-family: 'Courier New', monospace;
  color: var(--accent-gold);
  margin-bottom: 0.75rem;
  font-size: 0.875rem;
  font-weight: 600;
}

/* Card Actions */
.card-actions {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.folder-move-menu {
  display: flex;
  gap: 0.5rem;
  width: 100%;
}

/* Quantity Controls */
.quantity-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.75rem 0;
}

.quantity {
  font-weight: 600;
  color: var(--accent-primary);
  min-width: 40px;
  text-align: center;
}

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.section-header h2 {
  color: var(--text-primary);
  font-weight: 600;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 3rem 1.5rem;
  color: var(--text-secondary);
  background: var(--bg-tertiary);
  border-radius: 10px;
  border: 1px dashed var(--border-color);
}

.empty-state p {
  font-size: 1rem;
}

/* Decks Page Layout */
.decks-layout {
  display: grid;
  grid-template-columns: 350px 1fr;
  gap: 2rem;
  height: calc(100vh - 200px);
}

.deck-list-panel {
  background: var(--bg-secondary);
  border-radius: 12px;
  padding: 1.5rem;
  overflow-y: auto;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 2px solid var(--border-color);
}

.panel-header h2 {
  color: var(--text-primary);
  font-weight: 600;
}

/* New Deck Form */
.new-deck-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  padding: 1rem;
  background: var(--bg-tertiary);
  border-radius: 8px;
}

/* Deck List */
.deck-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.deck-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1rem;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.deck-item:hover {
  border-color: var(--accent-primary);
  box-shadow: var(--shadow);
}

.deck-item.active {
  border-color: var(--accent-primary);
  background: var(--bg-tertiary);
  box-shadow: var(--shadow-md);
}

.deck-item-content {
  flex: 1;
}

.deck-item h3 {
  color: var(--text-primary);
  margin-bottom: 0.25rem;
  font-size: 1rem;
  font-weight: 600;
}

.deck-format {
  color: var(--accent-primary);
  font-size: 0.875rem;
  margin-bottom: 0.125rem;
  font-weight: 500;
}

.deck-count {
  color: var(--text-secondary);
  font-size: 0.8125rem;
}

/* Deck Builder */
.deck-builder {
  background: var(--bg-secondary);
  border-radius: 12px;
  padding: 1.5rem;
  overflow-y: auto;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow);
}

.deck-builder.empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.deck-header {
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid var(--border-color);
}

.deck-header h2 {
  color: var(--text-primary);
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.deck-meta {
  color: var(--text-secondary);
  font-size: 0.9375rem;
}

.deck-description {
  color: var(--text-primary);
  margin-top: 0.5rem;
  font-style: italic;
}

/* Builder Columns */
.builder-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.deck-column, .collection-column {
  background: var(--bg-tertiary);
  border-radius: 8px;
  padding: 1rem;
  border: 1px solid var(--border-color);
}

.deck-column h3, .collection-column h3 {
  color: var(--text-primary);
  margin-bottom: 1rem;
  font-weight: 600;
  font-size: 1rem;
}

/* Card Lists */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  max-height: 500px;
  overflow-y: auto;
  padding-right: 0.5rem;
}

.card-list::-webkit-scrollbar {
  width: 8px;
}

.card-list::-webkit-scrollbar-track {
  background: var(--bg-secondary);
  border-radius: 4px;
}

.card-list::-webkit-scrollbar-thumb {
  background: var(--accent-primary);
  border-radius: 4px;
}

.deck-card-item, .collection-card-item {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 0.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s;
}

.deck-card-item:hover, .collection-card-item:hover {
  border-color: var(--accent-primary);
  box-shadow: var(--shadow-sm);
}

.card-name-qty {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: 1;
}

.card-qty {
  color: var(--accent-primary);
  font-weight: 600;
  min-width: 30px;
  font-size: 0.875rem;
}

.card-name {
  color: var(--text-primary);
  font-weight: 500;
  font-size: 0.9375rem;
}

.card-controls {
  display: flex;
  gap: 0.25rem;
}

.card-info-compact {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: 1;
}

.card-owned {
  color: var(--text-secondary);
  font-size: 0.8125rem;
}

/* Search Results */
.search-results {
  margin-top: 2rem;
}

.search-results h3 {
  color: var(--text-primary);
  margin-bottom: 1rem;
  font-weight: 600;
}

/* Scrollbars */
.folders-sidebar::-webkit-scrollbar,
.deck-builder::-webkit-scrollbar,
.deck-list-panel::-webkit-scrollbar {
  width: 8px;
}

.folders-sidebar::-webkit-scrollbar-track,
.deck-builder::-webkit-scrollbar-track,
.deck-list-panel::-webkit-scrollbar-track {
  background: var(--bg-tertiary);
  border-radius: 4px;
}

.folders-sidebar::-webkit-scrollbar-thumb,
.deck-builder::-webkit-scrollbar-thumb,
.deck-list-panel::-webkit-scrollbar-thumb {
  background: var(--border-hover);
  border-radius: 4px;
}

.folders-sidebar::-webkit-scrollbar-thumb:hover,
.deck-builder::-webkit-scrollbar-thumb:hover,
.deck-list-panel::-webkit-scrollbar-thumb:hover {
  background: var(--text-tertiary);
}

/* Search Page Specific */
.search-page-layout {
  max-width: 1200px;
  margin: 0 auto;
}

.search-main {
  width: 100%;
}

.search-description {
  color: var(--text-secondary);
  margin-bottom: 1.5rem;
  font-size: 0.9375rem;
}

.search-bar-large {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.search-input-large {
  flex: 1;
  padding: 1rem 1.25rem;
  background: var(--bg-secondary);
  border: 2px solid var(--border-color);
  border-radius: 10px;
  color: var(--text-primary);
  font-size: 1rem;
  transition: all 0.2s;
}

.search-input-large:focus {
  outline: none;
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
}

.btn-lg {
  padding: 1rem 2rem;
  font-size: 1rem;
}

.btn-full {
  width: 100%;
  justify-content: center;
}

.folder-selector {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.folder-selector label {
  font-weight: 500;
  color: var(--text-primary);
  font-size: 0.9375rem;
}

.quick-searches {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  padding: 1rem;
  background: var(--bg-tertiary);
  border-radius: 8px;
}

.quick-searches label {
  font-weight: 500;
  color: var(--text-primary);
  font-size: 0.9375rem;
}

.quick-search-buttons {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.search-help {
  margin-top: 1rem;
  padding: 1rem;
  background: var(--bg-tertiary);
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

.search-help summary {
  cursor: pointer;
  font-weight: 500;
  color: var(--text-primary);
  padding: 0.5rem;
  user-select: none;
}

.search-help summary:hover {
  color: var(--accent-primary);
}

.search-help-content {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
}

.help-section {
  margin-bottom: 1.5rem;
}

.help-section h4 {
  color: var(--text-primary);
  margin-bottom: 0.75rem;
  font-size: 0.9375rem;
  font-weight: 600;
}

.help-section ul {
  list-style: none;
  padding: 0;
}

.help-section li {
  padding: 0.375rem 0;
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.help-section code {
  background: var(--bg-secondary);
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-family: 'Courier New', monospace;
  color: var(--accent-primary);
  font-size: 0.875rem;
}

.help-footer {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
}

.help-footer a {
  color: var(--accent-primary);
  text-decoration: none;
  font-weight: 500;
}

.help-footer a:hover {
  text-decoration: underline;
}

.search-results-section {
  margin-top: 2rem;
}

.results-header {
  margin-bottom: 1.5rem;
}

.results-header h2 {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.results-count {
  font-size: 0.9375rem;
  font-weight: 400;
  color: var(--text-secondary);
}

.results-note {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin-top: 0.5rem;
}

.card-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0.5rem 0;
}

.card-price {
  color: var(--success);
  font-weight: 600;
  font-size: 0.875rem;
}

.empty-state-hint {
  color: var(--text-tertiary);
  font-size: 0.875rem;
  margin-top: 0.5rem;
}

.empty-state h3 {
  color: var(--text-primary);
  margin-bottom: 0.75rem;
  font-weight: 600;
}

.link {
  color: var(--accent-primary);
  text-decoration: none;
  font-weight: 500;
}

.link:hover {
  text-decoration: underline;
}

/* Responsive */
@media (max-width: 1200px) {
  .collection-layout {
    grid-template-columns: 240px 1fr;
  }
  
  .decks-layout {
    grid-template-columns: 300px 1fr;
  }
}

@media (max-width: 968px) {
  .collection-layout,
  .decks-layout {
    grid-template-columns: 1fr;
    height: auto;
  }

  .folders-sidebar,
  .deck-list-panel {
    position: relative;
    top: 0;
    max-height: 400px;
  }

  .builder-columns {
    grid-template-columns: 1fr;
  }

  .card-grid {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
}

@media (max-width: 640px) {
  .nav-container {
    padding: 1rem;
  }

  .nav-brand {
    font-size: 1.25rem;
  }

  .brand-text {
    display: none;
  }

  .nav-links {
    gap: 0.5rem;
  }

  .page-title {
    font-size: 1.5rem;
  }

  .card-grid {
    grid-template-columns: 1fr;
  }

  .search-bar {
    flex-direction: column;
  }

  .section-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .main-content {
    padding: 1rem;
  }
}

* {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  max-width: 100vw;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen,
    Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
}

/* Navigation */
.navigation {
  background: var(--bg-secondary);
  border-bottom: 2px solid var(--accent-primary);
  padding: 0;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.nav-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.5rem;
  font-weight: bold;
  color: var(--accent-gold);
}

.brand-icon {
  font-size: 2rem;
}

.nav-links {
  display: flex;
  gap: 2rem;
}

.nav-link {
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 1.1rem;
  font-weight: 500;
  padding: 0.5rem 1rem;
  border-radius: 8px;
  transition: all 0.3s;
}

.nav-link:hover {
  color: var(--text-primary);
  background: var(--bg-card);
}

.nav-link.active {
  color: var(--accent-primary);
  background: var(--bg-card);
}

/* Main Content */
.main-content {
  min-height: calc(100vh - 80px);
  padding: 2rem;
}

/* Page Container */
.page-container {
  max-width: 1400px;
  margin: 0 auto;
}

.page-title {
  font-size: 2.5rem;
  margin-bottom: 2rem;
  color: var(--accent-gold);
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

/* Cards & Sections */
.card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

.card h2, .card h3 {
  color: var(--accent-gold);
  margin-bottom: 1rem;
}

/* Search Section */
.search-section {
  margin-bottom: 2rem;
}

.search-bar {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.search-input {
  flex: 1;
  padding: 0.75rem 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 1rem;
}

.search-input:focus {
  outline: none;
  border-color: var(--accent-primary);
}

.filter-input {
  padding: 0.75rem 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 1rem;
  min-width: 250px;
}

.filter-input:focus {
  outline: none;
  border-color: var(--accent-primary);
}

/* Buttons */
.btn {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  background: var(--bg-card);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.btn-primary {
  background: var(--accent-primary);
  border-color: var(--accent-primary);
}

.btn-success {
  background: var(--success);
  border-color: var(--success);
}

.btn-danger {
  background: var(--danger);
  border-color: var(--danger);
}

.btn-sm {
  padding: 0.5rem 1rem;
  font-size: 0.9rem;
}

.btn-xs {
  padding: 0.25rem 0.5rem;
  font-size: 0.85rem;
}

/* Card Grid */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

.card-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1rem;
  transition: all 0.3s;
}

.card-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 12px rgba(233, 69, 96, 0.3);
  border-color: var(--accent-primary);
}

.card-image {
  width: 100%;
  border-radius: 8px;
  margin-bottom: 1rem;
}

.card-info h4 {
  color: var(--accent-gold);
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.card-type {
  color: var(--text-secondary);
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}

.card-set {
  color: var(--text-secondary);
  font-size: 0.85rem;
  margin-bottom: 0.5rem;
}

.mana-cost {
  font-family: 'Courier New', monospace;
  color: var(--accent-gold);
  margin-bottom: 0.75rem;
}

/* Quantity Controls */
.quantity-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.75rem 0;
}

.quantity {
  font-weight: bold;
  color: var(--accent-primary);
  min-width: 40px;
  text-align: center;
}

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.section-header h2 {
  color: var(--accent-gold);
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 3rem;
  color: var(--text-secondary);
}

.empty-state p {
  font-size: 1.1rem;
}

/* Decks Page Layout */
.decks-layout {
  display: grid;
  grid-template-columns: 350px 1fr;
  gap: 2rem;
  height: calc(100vh - 200px);
}

.deck-list-panel {
  background: var(--bg-secondary);
  border-radius: 12px;
  padding: 1.5rem;
  overflow-y: auto;
  border: 1px solid var(--border-color);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.panel-header h2 {
  color: var(--accent-gold);
}

/* New Deck Form */
.new-deck-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding: 1rem;
}

.input, .textarea, .select {
  padding: 0.75rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  color: var(--text-primary);
  font-size: 1rem;
  font-family: inherit;
}

.input:focus, .textarea:focus, .select:focus {
  outline: none;
  border-color: var(--accent-primary);
}

/* Deck List */
.deck-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.deck-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1rem;
  cursor: pointer;
  transition: all 0.3s;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.deck-item:hover {
  border-color: var(--accent-primary);
  box-shadow: 0 4px 8px rgba(233, 69, 96, 0.3);
}

.deck-item.active {
  border-color: var(--accent-primary);
  background: var(--bg-primary);
  box-shadow: 0 4px 8px rgba(233, 69, 96, 0.5);
}

.deck-item-content {
  flex: 1;
}

.deck-item h3 {
  color: var(--accent-gold);
  margin-bottom: 0.25rem;
  font-size: 1.1rem;
}

.deck-format {
  color: var(--accent-primary);
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
}

.deck-count {
  color: var(--text-secondary);
  font-size: 0.85rem;
}

/* Deck Builder */
.deck-builder {
  background: var(--bg-secondary);
  border-radius: 12px;
  padding: 1.5rem;
  overflow-y: auto;
  border: 1px solid var(--border-color);
}

.deck-builder.empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.deck-header {
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid var(--border-color);
}

.deck-header h2 {
  color: var(--accent-gold);
  margin-bottom: 0.5rem;
}

.deck-meta {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.deck-description {
  color: var(--text-primary);
  margin-top: 0.5rem;
  font-style: italic;
}

/* Builder Columns */
.builder-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}

.deck-column, .collection-column {
  background: var(--bg-card);
  border-radius: 8px;
  padding: 1rem;
  border: 1px solid var(--border-color);
}

.deck-column h3, .collection-column h3 {
  color: var(--accent-gold);
  margin-bottom: 1rem;
}

/* Card Lists */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  max-height: 500px;
  overflow-y: auto;
  padding-right: 0.5rem;
}

.card-list::-webkit-scrollbar {
  width: 8px;
}

.card-list::-webkit-scrollbar-track {
  background: var(--bg-primary);
  border-radius: 4px;
}

.card-list::-webkit-scrollbar-thumb {
  background: var(--accent-primary);
  border-radius: 4px;
}

.deck-card-item, .collection-card-item {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 0.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s;
}

.deck-card-item:hover, .collection-card-item:hover {
  border-color: var(--accent-primary);
}

.card-name-qty {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: 1;
}

.card-qty {
  color: var(--accent-primary);
  font-weight: bold;
  min-width: 30px;
}

.card-name {
  color: var(--text-primary);
  font-weight: 500;
}

.card-controls {
  display: flex;
  gap: 0.25rem;
}

.card-info-compact {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex: 1;
}

.card-owned {
  color: var(--text-secondary);
  font-size: 0.85rem;
}

/* Search Results */
.search-results {
  margin-top: 2rem;
}

.search-results h3 {
  color: var(--accent-gold);
  margin-bottom: 1rem;
}

/* Responsive */
@media (max-width: 1024px) {
  .decks-layout {
    grid-template-columns: 1fr;
    height: auto;
  }

  .deck-list-panel {
    max-height: 400px;
  }

  .builder-columns {
    grid-template-columns: 1fr;
  }

  .card-grid {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
}

@media (max-width: 768px) {
  .nav-container {
    padding: 1rem;
  }

  .nav-brand {
    font-size: 1.2rem;
  }

  .nav-links {
    gap: 1rem;
  }

  .page-title {
    font-size: 2rem;
  }

  .card-grid {
    grid-template-columns: 1fr;
  }

  .search-bar {
    flex-direction: column;
  }

  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
}
